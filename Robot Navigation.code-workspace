{
  "folders": [
    {
      "name": "Robot Navigation",
      "path": "autonomous-robot-navigation-rl"
    },
    {
      "name": "Project guide",
      "path": "docs"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/__pycache__": true,
      "**/.runtime": true,
      "**/.pytest_cache": true,
      "**/.venv": true,
      "**/artifacts": true,
      "**/runs": true,
      "**/data/partial": true,
      "**/build": true,
      "**/*.egg-info": true,
      "**/partial_phase5*.md": true,
      "**/partial_phase5*.json": true,
      "**/history": true
    },
    "search.exclude": {
      "**/archive/**": true,
      "**/artifacts/**": true,
      "**/runs/**": true,
      "**/.runtime/**": true,
      "**/history/**": true
    },
    "python.analysis.extraPaths": [
      "${workspaceFolder:Robot Navigation}/src"
    ],
    "explorer.compactFolders": false,
    "python.defaultInterpreterPath": "${workspaceFolder:Robot Navigation}/.venv/Scripts/python.exe"
  }
}
