{
  "folders": [
    { "name": "Robot Navigation", "path": "autonomous-robot-navigation-rl" },
    { "name": "Project guide", "path": "docs" }
  ],
  "settings": {
    "files.exclude": {
      "**/__pycache__": true,
      "**/.runtime": true,
      "**/.pytest_cache": true,
      "**/.venv": true,
      "**/artifacts": true,
      "**/runs": true,
      "**/data/partial": true,
      "**/build": true,
      "**/*.egg-info": true,
      "**/partial_phase5*.md": true,
      "**/partial_phase5*.json": true
    },
    "search.exclude": { "**/archive/**": true, "**/artifacts/**": true, "**/runs/**": true, "**/.runtime/**": true },
    "python.testing.pytestEnabled": true,
    "python.testing.cwd": "${workspaceFolder:Robot Navigation}",
    "python.testing.pytestArgs": ["developer/tests"],
    "python.analysis.extraPaths": ["${workspaceFolder:Robot Navigation}/src"],
    "explorer.compactFolders": false
  }
}
