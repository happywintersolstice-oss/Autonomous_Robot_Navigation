{
  "files.exclude": {
    "**/__pycache__": true,
    "**/.runtime": true,
    "**/.venv": true,
    "**/build": true,
    "**/*.egg-info": true,
    "archive": true,
    "docs/history": true,
    "autonomous-robot-navigation-rl/artifacts": true,
    "autonomous-robot-navigation-rl/runs": true,
    "autonomous-robot-navigation-rl/data/partial": true
  },
  "search.exclude": {
    "archive/**": true,
    "docs/history/**": true,
    "**/.runtime/**": true,
    "**/artifacts/**": true,
    "**/runs/**": true
  },
  "python.analysis.extraPaths": [
    "${workspaceFolder}/autonomous-robot-navigation-rl/src"
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/autonomous-robot-navigation-rl/.venv/Scripts/python.exe"
}
