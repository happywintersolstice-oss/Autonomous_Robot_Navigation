# Auto detect text files and perform LF normalization
* text=auto
# The registered Phase 5A protocol hashes the brief's exact bytes.
CODEX_PHASE5_LEARNING_FEASIBILITY_PILOT.md -text whitespace=cr-at-eol
CODEX_PHASE5B_BASIC_NAVIGATION_DIAGNOSIS.md -text whitespace=cr-at-eol
# Preserve the inventoried on-disk bytes across checkout platforms.
CODEX_*.md -text
autonomous-robot-navigation-rl/artifacts/partial-dynamic-navigation-v1/** -text
autonomous-robot-navigation-rl/data/partial/** -text
autonomous-robot-navigation-rl/docs/partial_* -text
autonomous-robot-navigation-rl/configs/partial_* -text
# New rubric evidence/figures keep their recorded bytes across Windows checkouts.
docs/rubric-evidence/** -text whitespace=cr-at-eol
docs/submission/figures/** -text whitespace=cr-at-eol
# Matplotlib's SVG path strings intentionally contain trailing separator spaces.
docs/submission/figures/*.svg -text whitespace=cr-at-eol,-blank-at-eol
docs/submission/*.pdf binary

# Relocated historical documents retain their original inventoried bytes.
docs/history/** -text -whitespace
