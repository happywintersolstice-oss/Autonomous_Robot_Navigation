# Preserve source/checkpoint provenance across Windows and Unix checkouts.
* text=auto eol=lf
*.npz binary
*.zip binary
*.png binary
# Legacy Windows-generated records have raw-byte preservation hashes.
artifacts/**/*.json text eol=crlf
artifacts/**/*.csv text eol=crlf
artifacts/**/*.log text eol=crlf
data/scenarios/*.json text eol=crlf
artifacts/studies/part-b-v1/report.md text eol=crlf
# Analysis publication verifies raw output bytes after checkout.
artifacts/studies/four-rl-analysis-*/* -text whitespace=cr-at-eol
artifacts/studies/representation-*/* -text whitespace=cr-at-eol
artifacts/runs/m8-*/** -text whitespace=cr-at-eol
artifacts/runs/learning-replay-*/** -text whitespace=cr-at-eol
artifacts/studies/learning-replays-*/* -text whitespace=cr-at-eol
artifacts/runs/m9-*/** -text whitespace=cr-at-eol
artifacts/studies/neural-tuning-*/* -text whitespace=cr-at-eol
artifacts/studies/neural-confirmation-*/** -text whitespace=cr-at-eol
data/unseen/** -text whitespace=cr-at-eol
artifacts/studies/unseen-map-*/** -text whitespace=cr-at-eol
# Keep the registered live protocol byte-identical to its diagnostic manifest.
docs/milestone13_protocol.md -text whitespace=cr-at-eol
# Structured-map and loop-intervention records carry raw-byte checksums.
data/navigation-lab/** -text whitespace=cr-at-eol
artifacts/studies/map-reward-study-v1/** -text whitespace=cr-at-eol
artifacts/studies/loop-recovery-dev-v1/** -text whitespace=cr-at-eol
docs/navigation_lab_protocol.md -text whitespace=cr-at-eol
docs/loop_intervention_protocol.md -text whitespace=cr-at-eol
docs/evidence/*.json -text whitespace=cr-at-eol
# Warehouse map, routes and model records have their own byte-pinned provenance.
data/warehouse/** -text whitespace=cr-at-eol
artifacts/warehouse/** -text whitespace=cr-at-eol

# Registered warehouse comparison protocol is a raw-byte study input.
docs/warehouse_comparison_protocol.md -text whitespace=cr-at-eol
